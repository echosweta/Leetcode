        //             ans.push_back(j + 1);
        //             found = true;

        //         }

        //         else
        //             continue;
        //     }
        // }

        // two pointer

        int i = 0;
        int j = nums.size() - 1;

        while (i < j) {
            if (nums[i] + nums[j] == target) {
                ans.push_back(i + 1);
                ans.push_back(j + 1);
                break;
            }

            if (nums[i] + nums[j] > target)
                j--;
            else
                i++;
        }

        return ans;
    }
