class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {

        vector<int> ans(nums.size());
        int l = 0;
        int r = nums.size() - 1;

        //using two pointers for swapping

        for (int i = nums.size() - 1; i >= 0; i--) {
            // int x = nums[i] * nums[i];
            // nums[i] = x;
            if (abs(nums[l]) > abs(nums[r])) {
                ans[i] = nums[l] * nums[l];
                l++;
            } else {
                ans[i] = nums[r] * nums[r];
                r--;
            }
        }

        return ans;
    }
};
