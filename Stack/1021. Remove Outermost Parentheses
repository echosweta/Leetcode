class Solution {
public:
    string removeOuterParentheses(string s) {
        int ob = 0;
        int cb = 0;
        bool f = false;
        string ans = "";
        string temp = "";

        for (int i = 0; i < s.length(); i++) {

            if (s[i] == '(') {
                ob++;
                temp += s[i];
                f = true;
            } else if (s[i] == ')') {
                cb++;
                temp += s[i];
                f = true;
            }

            if (ob == cb && f) {
                ob = 0;
                cb = 0;
                temp = temp.substr(1, temp.length() - 2);
                ans += temp;
                f = false;
                temp = "";
            }
        }
        return ans;
    }
};
