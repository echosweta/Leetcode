class Solution {
public:
    bool backspaceCompare(string s, string t) {
        return finalString(s) == finalString(t);
    }

    string finalString(string s) {
        string ans = "";
        for (int i = 0; i < s.length(); i++) {
            if (!ans.empty() && s[i] == '#') {
                ans.pop_back();
            } else {
                if (s[i] != '#')
                    ans += s[i];
            }
        }
        cout << ans;
        return ans;
    }
};
