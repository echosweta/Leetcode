class Solution {
public:
    string mergeAlternately(string word1, string word2) {
        string ans= "";
        for(int i =0;i<word1.size();i++)
        {
            ans+=word1[i];
            if(word2.size()-1<i) continue;
            else ans+=word2[i];

        }

        if(word1.size()<word2.size())
        {
            string sub1 = word2.substr(word1.size(), word2.size()); 
            ans+=sub1;
        }

        return ans;

        
    }
};
